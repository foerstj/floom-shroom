[t:template,n:base_transformed_floom_shroom]
{
	specializes = actor_ambient;

	category_name = "foliage";
	doc = "shroom_red_med";
	[aspect]
	{
		is_selectable = true;
		draw_shadow = true;
		rollover_highlight = true;
		is_invincible = true;
		is_collidable = true;

		max_life = 100;
		life = 100;
		max_mana = 100;
		mana = 100;
	}
	[actor]
	{
		race=other;
	}
	[body]
	{
		avg_move_velocity = 0.000000;
		[chore_dictionary]
		{
			chore_prefix = a_c_na_dg2_fs;
			[chore_default]
			{
				chore_stances = 0;
				skrit = infinite_loop;
				[anim_files] { 00=ds; }
			}
		}
	}
	[mind]
	{
		jat_face          		= jat_none;
		jat_move          		= jat_none;
		jat_attack_object       = jat_none;
		jat_die          		= jat_none;
		movement_orders			= mo_hold;
	}
}

