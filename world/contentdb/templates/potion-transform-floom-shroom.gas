[t:template,n:potion_transform_floom_shroom]
{
	specializes         = base_potion_good;
	doc                 = "potion_transform_floom_shroom";
	category_name       = "potions";

	[aspect]
	{
		model = m_i_cav_mushrooms-06;
		textures:0 = b_i_cav_mushrooms-01;
	}
	aspect:voice:put_down:* 			= s_e_gui_pick_up;
   	aspect:gold_value   = 1;

	[common]
	{
		screen_name = "Red Spotted Floom Shroom";
		description = "Eat me and turn into a mushroom!";
		is_pcontent_allowed = false;
	}
	[magic]
	{
		[enchantments]
		{
			//[*]
			//{
			//	alteration          = alter_mana;
			//	value               = 300.0;
			//	//description         = "Raise Mana";
			//	duration            = 0;
			//	frequency           = 0;
			//	is_active           = false;
			//	is_enhancement      = true;
			//	is_permanent        = true;
			//	is_single_instance  = false;
			//	is_transmissible    = false;
			//	is_value_limited    = true;
			//	effect_script_equip = rejuv_potion_small;
			//
			//}
			//[*]
			//{
			//	alteration          = alter_life;
			//	value               = 300.0;
			//	//description         = "Raise Health";
			//	duration            = 0;
			//	frequency           = 0;
			//	is_active           = false;
			//	is_enhancement      = true;
			//	is_permanent        = true;
			//	is_single_instance  = false;
			//	is_transmissible    = false;
			//	is_value_limited    = true;
			//}
		}

		// from base_spell_transform_good
		mana_cost = 0;
		//mana_cost_modifier = (#magic+1)*6-.7;
		effect_duration = 10;  // 2304 real seconds = 1 ingame day
		apply_enchantments = false;
		cast_range = 10;
		cast_reload_delay = 0;
		is_one_shot = true;
		requires_line_of_sight = false;
		speed_bias = 1;
		state_name = Transformed;	// make sure to use this state name for ALL transformation spells.	it is used in inhibiting actions
		target_type_flags = tt_self;
		require_state_check = false;
	}

	gui:inventory_icon          = b_gui_ig_i_it_mushroom-red-spotted-large;
	gui:inventory_height = 2;
	gui:inventory_width = 1;

	//potion:inventory_icon_2     = b_gui_ig_i_it_potion-fill-rejuvenation-001;

	[potion_transformation_speed_affector]
	{
		Description = "Transformed";
		effect_script = "transform_barkrunner";
		templateName = "transformed_floom_shroom";	// template name of creature we are transforming into
		effect_params = "[scale(19.0)]";

		walkModifier = 0.0;
		blockingState = "haste";  // Prevent transformation when Haste is active - end of Haste would reset walk speed
	}
}
